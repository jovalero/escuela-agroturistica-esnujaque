# ==============================================================================
# VARIABLES DE ENTORNO — ESCUELA TÉCNICA AGROTURÍSTICA DE LA MESA DE ESNUJAQUE
# Copiá este archivo a .env.local para desarrollo local o configuralas en Vercel
# ==============================================================================

# URL pública del sitio (usada en sitemap.xml, robots.txt, canonicals y Open Graph)
NEXT_PUBLIC_SITE_URL="https://escuelaagroturisticaesnujaque.vercel.app"

# ------------------------------------------------------------------------------
# ENVÍO DE CORREOS CON RESEND (Opcional - Para Contacto, Aportes y Encuesta)
# Obtené tu API Key gratuita en https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL=""
RESEND_FROM_EMAIL="Anteproyecto Esnujaque <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DE LA ENCUESTA COMUNITARIA (Opcional - Elegí una o combiná ambas)
# 1. Google Sheets (vía Google Apps Script Web App URL)
# 2. Supabase (URL del proyecto y Service Role / Anon Key)
# Si no se configuran, las respuestas se guardan localmente en /data/submissions
# durante el desarrollo y se envían por email si RESEND_API_KEY está activo.
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
